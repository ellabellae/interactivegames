{
  // Type checking only. Source stays plain JavaScript; `npm run check` runs tsc
  // with noEmit so a mistyped setting name or wrong argument is caught in CI.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["packages/*/src", "packages/*/build", "apps/*/src", "apps/*/vite.config.js", "scripts"]
}
